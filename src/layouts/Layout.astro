---
// src/layouts/Layout.astro
// Shared chrome ported from genai/src/routes/__root.tsx (head/meta, fonts,
// theme-color, global stylesheet). Interactive page bodies mount as Astro
// islands from within the <slot />.
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const site = "https://pqhorizon.com";
const {
  title = "PQHorizon — Post-Quantum Crypto Readiness",
  description = "See what breaks before your auditor asks. Free post-quantum TLS preview and full cryptographic inventory for teams facing PQ migration deadlines.",
  canonical = `${site}/`,
} = Astro.props;
const ogImage = `${site}/og-image.png`;
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1418" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="PQHorizon" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts (ported from __root.tsx) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <!-- GA4 — injected only when PUBLIC_GA_ID is set (Cloudflare env var, inlined at build). -->
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
